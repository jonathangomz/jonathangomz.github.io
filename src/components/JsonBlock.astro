---
/**
 * Renders a flat object as syntax-coloured JSON without shipping a highlighter.
 *
 * Keys and values are separate grid cells rather than text padded with spaces,
 * so the value column aligns itself to the widest key and long arrays reflow
 * inside the panel instead of scrolling sideways. Wrapped lines land under the
 * start of the value, the way a formatter would indent them.
 *
 * Only used for genuinely flat, short data (/stack, /contact) — anything with
 * prose in it is served as text/markdown and rendered as writing instead.
 */
interface Props {
	data: Record<string, string | string[]>;
}

const { data } = Astro.props;

const escape = (value: string) =>
	value
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;');

const str = (value: string) => `<span class="s">"${escape(value)}"</span>`;
const punct = (value: string) => `<span class="p">${value}</span>`;

const entries = Object.entries(data);

/* The single space after each comma is the only place a line may break, since
   .s is nowrap — so a value never splits in the middle. */
const rows = entries.map(([key, value], index) => {
	const rendered = Array.isArray(value)
		? punct('[') + value.map(str).join(punct(',') + ' ') + punct(']')
		: str(value);
	const comma = index < entries.length - 1 ? punct(',') : '';

	return (
		`<span class="kc"><span class="k">"${escape(key)}"</span>${punct(':')}</span>` +
		`<span class="v">${rendered}${comma}</span>`
	);
});
---

<div class="json">
	<span class="p">&#123;</span>
	<div class="json-rows" set:html={rows.join('')}></div>
	<span class="p">&#125;</span>
</div>
