---
/**
 * Renders a flat object as syntax-coloured JSON without shipping a highlighter.
 *
 * The markup is assembled here rather than in the template because inside a
 * <pre> the template's own indentation becomes significant whitespace, which
 * puts every token on its own line. Building the string gives exact control.
 *
 * Only used for genuinely flat, short data (/stack, /contact) — anything with
 * prose in it is served as text/markdown and rendered as writing instead.
 */
interface Props {
	data: Record<string, string | string[]>;
	/** Pad keys so values line up, the way a formatter would. */
	align?: boolean;
}

const { data, align = true } = Astro.props;

const escape = (value: string) =>
	value
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;');

const str = (value: string) => `<span class="s">"${escape(value)}"</span>`;
const punct = (value: string) => `<span class="p">${value}</span>`;

const entries = Object.entries(data);
const width = align ? Math.max(...entries.map(([key]) => key.length)) : 0;

const lines = entries.map(([key, value], index) => {
	const gap = ' '.repeat(width - key.length + 1);
	const rendered = Array.isArray(value)
		? punct('[') + value.map(str).join(punct(', ')) + punct(']')
		: str(value);
	const comma = index < entries.length - 1 ? punct(',') : '';

	return `  <span class="k">"${escape(key)}"</span>${punct(':')}${gap}${rendered}${comma}`;
});

const json = [punct('{'), ...lines, punct('}')].join('\n');
---

<pre class="json" set:html={json}></pre>
