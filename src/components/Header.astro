---
// The header boots as a `dotnet run`, then docks: the command shrinks and the
// header — already sticky — becomes a status bar that stays while you read.
//
// Everything here is real markup, visible by default. The animation is an
// entrance on top of a working header, so it survives JavaScript being off and
// is skipped entirely under prefers-reduced-motion.
---

<header class="app-header">
	<div class="dock">
		<div class="splash">
			<div class="brand">
				<h1><span class="cmd"><span class="sign">$</span> dotnet run JonathanGomez</span><span
						class="underline-blink">_</span></h1>
				<p class="status"><span class="dot" aria-hidden="true">●</span> running</p>
			</div>
			<div class="boot">
				<span class="boot-line" style="--step: 1">Building...</span>
				<span class="boot-line" style="--step: 2"><span class="info">info</span>: Microsoft.Hosting.Lifetime[0]</span>
				<span class="boot-line" style="--step: 3">      Now listening on: https://jonathangomz.github.io</span>
				<span class="boot-line" style="--step: 4">      Application started.</span>
			</div>
		</div>
	</div>
</header>
