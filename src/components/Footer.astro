---
import SocialIcon from './SocialIcon.astro';
import { contact } from '../data/profile';

// Renders from the same list as GET /contact, so the links cannot drift.
---

<footer class="icons-social">
	{
		contact.map((link) => (
			<a target="_blank" href={link.href} rel="noreferrer" aria-label={link.key}>
				<SocialIcon name={link.icon} />
			</a>
		))
	}
</footer>
