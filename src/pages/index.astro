---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Route from '../components/Route.astro';
import JsonBlock from '../components/JsonBlock.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';

import { projects } from '../data/projects';
import { about, experience, stack, contact } from '../data/profile';
---

<BaseLayout>
	<Header />

	<main class="shell">
		<div class="routes">
			<Route path="/about" note="summary" type="text/markdown" ms={3} open>
				<div class="doc">
					{about.paragraphs.map((text) => <p>{text}</p>)}
					<blockquote>{about.philosophy}</blockquote>
				</div>
			</Route>

			<Route path="/experience" note="8+ years" type="text/markdown" ms={7}>
				<div class="doc">
					{
						experience.map((job) => (
							<div class="job">
								<h3>{job.company}</h3>
								<span class="period">{job.role} · {job.period} · {job.location}</span>
								<ul>
									{job.highlights.map((h) => <li>{h}</li>)}
								</ul>
							</div>
						))
					}
				</div>
			</Route>

			<Route path="/stack" note="technologies" type="application/json" ms={2}>
				<JsonBlock data={stack} />
			</Route>

			<Route path="/projects" note={`${projects.length + 1} items`} type="text/html" ms={11}>
				<div class="cards">
					{projects.map((project) => <ProjectCard {...project} />)}
					<div class="card soon">
						<span class="card-title">Soon...</span>
						<hr />
						<p class="card-details">Soon more projects.</p>
						<div class="card-actions"></div>
					</div>
				</div>
			</Route>

			<Route path="/contact" note={`${contact.length} links`} type="application/json" ms={2}>
				<ContactBlock links={contact} />
			</Route>
		</div>
	</main>

	<Footer />
</BaseLayout>
