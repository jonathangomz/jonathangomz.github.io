---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
---

<BaseLayout>
	<Header name="Jonathan Gómez" />
	<main>
		<section id="projects" class="projects">
			<div class="section-header">
				<h1 class="section-title">Project<span class="blink do-blink">s</span></h1>
				<p class="section-details">Here are some projects that I just made for fun.</p>
				<hr />
			</div>
			<div class="cards">
				{projects.map((project) => <ProjectCard {...project} />)}
				<div class="card soon">
					Soon...
					<hr />
					<p class="card-details">Soon more projects.</p>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
