---
import { Font } from 'astro:assets';

import '../styles/reset.css';
import '../styles/styles.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Jonathan Gómez | Dev',
	description = 'Author: J.C. Gómez, Year: 2020',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		<Font cssVariable="--font-jetbrains-mono" preload />

		<script is:inline>
			// Runs before first paint so neither the theme nor the docked header
			// flashes in after the page has already drawn.
			(function () {
				var root = document.documentElement;

				// Remembered theme. Dark is the deliberate default — the site is a
				// terminal — so prefers-color-scheme is not consulted; light is an
				// explicit choice that is then kept.
				try {
					var theme = localStorage.getItem("theme");
					if (theme) root.setAttribute("data-theme", theme);
				} catch (e) {
					/* storage blocked: the default theme is already correct */
				}

				// Cold start once per session; warm starts skip straight to the
				// docked header, the way a real app skips its startup cost.
				try {
					if (sessionStorage.getItem("booted")) root.classList.add("warm");
					sessionStorage.setItem("booted", "1");
				} catch (e) {
					/* private mode: just play the boot */
				}

				// Reveals the theme picker. Without this the control stays hidden,
				// so a visitor with JavaScript off never sees a dead menu.
				root.setAttribute("data-js", "");
			})();
		</script>
	</head>

	<body>
		<slot />

		<script is:inline>
			(function () {
				var select = document.getElementById("theme-select");
				if (!select) return;
				var root = document.documentElement;

				select.value = root.getAttribute("data-theme") || "terminal";

				select.addEventListener("change", function () {
					root.setAttribute("data-theme", select.value);
					try {
						localStorage.setItem("theme", select.value);
					} catch (e) {
						/* storage blocked: the choice still applies for this page */
					}
				});
			})();
		</script>
	</body>
</html>
